# Apni keys yahan likhein, phir is file ka naam ".env" kar dein.
ANTHROPIC_API_KEY=sk-ant-yahan-apni-key
# Sirf ElevenLabs use karna ho to:
ELEVENLABS_API_KEY=
# Backup subtitles (muft): console.groq.com > API Keys
GROQ_API_KEY=
# Shorts phone par (README ka Telegram hissa): @BotFather se token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Computer se Telegram band ho to (VPN ke bajaye): jaise socks5h://127.0.0.1:1080
TELEGRAM_PROXY=
# Apna Cloudflare relay (README: Telegram relay), jaise https://tg-relay.NAAM.workers.dev
TELEGRAM_API_URL=
